# Apenas valores fictícios para desenvolvimento local. Não usar em produção.
POSTGRES_PASSWORD=local_example
DATABASE_URL=postgresql://autoclips:local_example@localhost:5432/autoclips
REDIS_HOST=localhost
REDIS_PORT=6379
WORKER_URL=http://127.0.0.1:8000
API_URL=http://127.0.0.1:3003
MEDIA_ROOT=./media
WHISPER_MODEL=tiny
WHISPER_CPU_THREADS=2

# Seleção: simulação por padrão, nenhuma API paga habilitada.
LLM_PROVIDER=mock
LLM_MODEL=mock-v1
LLM_ALLOW_EXTERNAL=false
LLM_OLLAMA_URL=http://host.docker.internal:11434
LLM_MAX_INPUT_TOKENS=6000
LLM_MAX_OUTPUT_TOKENS=1600
LLM_RUN_TOKEN_BUDGET=30000
LLM_DAILY_TOKEN_BUDGET=100000
LLM_RUN_COST_MICROS=0
LLM_DAILY_COST_MICROS=0
LLM_MAX_CHUNKS=8
LLM_MAX_CLIPS=5
LLM_MIN_DURATION=5
LLM_MAX_DURATION=60
LLM_MIN_SCORE=4.5
