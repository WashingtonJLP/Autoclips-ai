# Apenas valores fictícios para desenvolvimento local. Não usar em produção.
POSTGRES_PASSWORD=local_example
# Endereços internos Docker: estes serviços não publicam portas no host.
DATABASE_URL=postgresql://autoclips:local_example@postgres:5432/autoclips
REDIS_HOST=redis
REDIS_PORT=6379
WORKER_URL=http://worker:8000
# API publicada no host. O Compose injeta http://api:3001 no container web.
API_URL=http://127.0.0.1:3101
MEDIA_ROOT=./media
WHISPER_MODEL=tiny
WHISPER_CPU_THREADS=2
INTERNAL_API_TOKEN=
WORKER_API_TOKEN=
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
PLATFORM_TOKEN_KEY=
SOURCE_MANIFEST_URLS=[]
MEDIA_DOWNLOAD_HOSTS=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3100/oauth/youtube
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# Neon opcional: URL pooled para runtime, direta para migrações. Sempre TLS.
NEON_DATABASE_URL=
NEON_DIRECT_DATABASE_URL=

# Seleção: simulação por padrão, nenhuma API paga habilitada.
LLM_PROVIDER=mock
LLM_MODEL=mock-v1
LLM_ALLOW_EXTERNAL=false
LLM_ALLOW_PAID=false
OPENAI_API_KEY=
# Limites de preço em USD/milhão de tokens do modelo explícito, conferidos pelo operador.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
LLM_OLLAMA_URL=http://host.docker.internal:11434
LLM_MAX_INPUT_TOKENS=6000
LLM_MAX_OUTPUT_TOKENS=1600
LLM_RUN_TOKEN_BUDGET=30000
LLM_DAILY_TOKEN_BUDGET=100000
LLM_RUN_COST_MICROS=0
LLM_DAILY_COST_MICROS=0
LLM_MAX_CHUNKS=8
LLM_MAX_CLIPS=5
LLM_MIN_DURATION=5
LLM_MAX_DURATION=60
LLM_MIN_SCORE=4.5
