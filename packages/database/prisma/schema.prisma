generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model Source {
  purpose String @default("monitoring")
  id String @id @default(cuid())
  name String
  url String
  license String
  evidenceUrl String
  attribution String
  verifiedAt DateTime
  commercialUseVerified Boolean @default(false)
  createdAt DateTime @default(now())
  tasks Task[]
  connectorKey String? @unique
  mediaUrl String?
  evidence Json?
}
model Task {
  deletedAt DateTime?
  testContent Boolean @default(false)
  id String @id @default(cuid())
  sourceId String
  source Source @relation(fields: [sourceId], references: [id])
  operation String
  status String @default("QUEUED")
  payload Json
  result Json?
  error String?
  renderKey String? @unique
  editorial Json?
  autoRun Boolean @default(false)
  continuationDone Boolean @default(false)
  parentId String?
  llmCalls LlmCall[]
  publications Publication[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}

model MediaAsset {
  testContent Boolean @default(false)
  id String @id @default(cuid())
  identity String @unique
  platform String
  externalId String?
  url String
  title String
  author String?
  duration Float?
  language String?
  publishedAt DateTime?
  sourceId String?
  mediaUrl String?
  path String?
  sha256 String? @unique
  rightsConfirmed Boolean @default(false)
  accessible Boolean @default(false)
  reason String?
  metadata Json
  createdAt DateTime @default(now())
}

model Automation {
  id String @id @default(cuid())
  name String
  kind String
  enabled Boolean @default(true)
  intervalMinutes Int
  config Json
  createdAt DateTime @default(now())
  runs SearchRun[]
}

model SearchRun {
  id String @id @default(cuid())
  automationId String
  automation Automation @relation(fields: [automationId], references: [id])
  status String @default("PROCESSING")
  found Int @default(0)
  processed Int @default(0)
  error String?
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@index([automationId, createdAt])
}

model PlatformAccount {
  platform String @id
  encryptedTokens String
  updatedAt DateTime @updatedAt
}

model Publication {
  id String @id @default(cuid())
  taskId String
  task Task @relation(fields: [taskId], references: [id])
  platform String
  scheduledAt DateTime
  status String @default("SCHEDULED")
  result Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([taskId, platform])
}
model LlmBudget {
  day String @id
  tokens BigInt @default(0)
  costMicros BigInt @default(0)
}
model LlmCall {
  key String @id
  taskId String
  task Task @relation(fields: [taskId], references: [id])
  day String
  provider String
  model String
  inputReserved Int
  outputReserved Int
  costReservedMicros Int
  inputTokens Int?
  outputTokens Int?
  costMicros Int?
  state String @default("RESERVED")
  response Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([day, createdAt])
  @@index([taskId])
}
