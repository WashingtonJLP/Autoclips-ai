generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model Source {
  id String @id @default(cuid())
  name String
  url String
  license String
  evidenceUrl String
  attribution String
  verifiedAt DateTime
  commercialUseVerified Boolean @default(false)
  createdAt DateTime @default(now())
  tasks Task[]
}
model Task {
  id String @id @default(cuid())
  sourceId String
  source Source @relation(fields: [sourceId], references: [id])
  operation String
  status String @default("QUEUED")
  payload Json
  result Json?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}
