{
  "name": "autoclips-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/database"
  ],
  "engines": {
    "node": ">=22.17.0 <23"
  },
  "scripts": {
    "dev:web": "npm run dev -w @autoclips/web",
    "dev:api": "npm run dev -w @autoclips/api",
    "build": "npm run generate -w @autoclips/database && npm run build -w @autoclips/api && npm run build -w @autoclips/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w @autoclips/api && npm run test -w @autoclips/web",
    "db:generate": "npm run generate -w @autoclips/database",
    "db:migrate": "npm run migrate -w @autoclips/database"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "eslint": "^10.13.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
